#!/usr/bin/env bash
# Stub de qwen. consenso invoca qwen en modo texto (sin --output-format json):
# imprime el array de hallazgos entre fences markdown directamente a stdout,
# como haría el modelo al pedírsele solo JSON. El ruido real (warnings, spinner,
# errores de API) va a stderr, así que stdout queda limpio para desenfence +
# parseo. Variables: STUB_QWEN_OUT, STUB_QWEN_EMPTY, STUB_QWEN_RC, STUB_QWEN_SLEEP.
sleep "${STUB_QWEN_SLEEP:-0}"
if [ -z "${STUB_QWEN_EMPTY:-}" ]; then
  if [ -n "${STUB_QWEN_OUT:-}" ]; then
    printf '%s' "$STUB_QWEN_OUT"
  else
    printf '```json\n[{"severidad":"menor","ubicacion":"foo.py:1","problema":"sin test","propuesta":"anadir test"}]\n```'
  fi
fi
exit "${STUB_QWEN_RC:-0}"
