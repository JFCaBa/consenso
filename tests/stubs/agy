#!/usr/bin/env bash
# Stub de agy (invocado como "agy" desde consenso.sh) para tests. Emula las
# dos formas reales en que consenso.sh invoca al CLI:
#   1) prosa (debate):        agy --dangerously-skip-permissions --model .. -p "<prompt>"
#      -> imprime el texto de prosa a stdout.
#   2) JSON estructurado (round0): ... --output-format json --json-schema <f> -p "<prompt>"
#      -> imprime el sobre {"structured_output":{"hallazgos":[...]}, ...} a stdout,
#      igual que hace agy real con --output-format json.
#
# Variables:
#   STUB_AGY_OUT   -> en modo JSON: array de hallazgos. En modo prosa: texto.
#   STUB_AGY_EMPTY -> si está seteada, no imprime nada (simula salida vacía).
#   STUB_AGY_SLEEP / STUB_AGY_RC
sleep "${STUB_AGY_SLEEP:-0}"

# Subcomando `models`: emula `agy models` (lista "ID<TAB>nombre"), usado por la
# resolución dinámica de modelo. STUB_AGY_MODELS override; STUB_AGY_MODELS_EMPTY
# simula un CLI que no devuelve modelos.
if [ "${1:-}" = "models" ]; then
  if [ -n "${STUB_AGY_MODELS_EMPTY:-}" ]; then
    exit "${STUB_AGY_RC:-0}"
  fi
  if [ -n "${STUB_AGY_MODELS:-}" ]; then
    printf '%s\n' "$STUB_AGY_MODELS"
  else
    # Versiones desordenadas y con doble dígito (3.10) para verificar que la
    # resolución elige el más nuevo por orden de versión, no por float.
    printf 'Fetching available models...\n'
    printf 'gemini-3.8-flash-high\tGemini 3.8 Flash (High)\n'
    printf 'gemini-3.10-flash-high\tGemini 3.10 Flash (High)\n'
    printf 'gemini-3.9-flash-high\tGemini 3.9 Flash (High)\n'
    printf 'gemini-3.6-flash-high\tGemini 3.6 Flash (High)\n'
    printf 'gemini-3.1-pro-high\tGemini 3.1 Pro (High)\n'
  fi
  exit "${STUB_AGY_RC:-0}"
fi

json_mode=0
for a in "$@"; do
  case "$a" in
    --output-format|--json-schema) json_mode=1 ;;
  esac
done

default_hallazgos() {
  printf '%s' '[{"severidad":"menor","ubicacion":"foo.py:1","problema":"sin docstring","propuesta":"anadir docstring"}]'
}
default_prose() {
  printf '%s' 'agy prosa de prueba: sin docstring'
}

if [ -z "${STUB_AGY_EMPTY:-}" ]; then
  if [ "$json_mode" = "1" ]; then
    body="${STUB_AGY_OUT:-$(default_hallazgos)}"
    printf '{"structured_output":{"hallazgos":%s}}' "$body"
  else
    printf '%s' "${STUB_AGY_OUT:-$(default_prose)}"
  fi
fi

exit "${STUB_AGY_RC:-0}"
