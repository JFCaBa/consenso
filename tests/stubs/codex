#!/usr/bin/env bash
# Stub de codex para tests. Emula las dos formas reales en que consenso.sh
# invoca al CLI:
#   1) prosa (debate):        codex exec --skip-git-repo-check "<prompt>"
#      -> imprime a stdout.
#   2) JSON estructurado (round0): ... --output-schema <f> -o <out> "<prompt>"
#      -> escribe {"hallazgos": [...]} en <out> (el fichero de -o), no en stdout.
#
# Variables:
#   STUB_CODEX_OUT      -> en modo JSON: array de hallazgos (default: 1 hallazgo
#                          de ejemplo). En modo prosa: texto completo de salida.
#   STUB_CODEX_COUNTER  -> path a fichero contador; si se setea, habilita
#                          distinguir 1a/2a llamada (retry).
#   STUB_CODEX_FAIL_FIRST -> si está seteada junto a STUB_CODEX_COUNTER, la 1a
#                          llamada sale con rc=1 sin escribir nada (simula un
#                          fallo transitorio del CLI que el reintento recupera).
#   STUB_CODEX_EMPTY    -> si está seteada, no escribe nada en -o (rc sigue
#                          siendo STUB_CODEX_RC; simula salida vacía).
#   STUB_CODEX_SLEEP    -> segundos a dormir antes de responder (default 0).
#   STUB_CODEX_RC       -> código de salida (default 0).
sleep "${STUB_CODEX_SLEEP:-0}"

out_file=""
prev=""
for a in "$@"; do
  if [ "$prev" = "-o" ]; then
    out_file="$a"
  fi
  prev="$a"
done

if [ -n "${STUB_CODEX_COUNTER:-}" ]; then
  count="0"
  if [ -f "$STUB_CODEX_COUNTER" ]; then
    count="$(cat "$STUB_CODEX_COUNTER" 2>/dev/null)"
    [ -n "$count" ] || count="0"
  fi
  next=$((count + 1))
  printf '%s' "$next" > "$STUB_CODEX_COUNTER"
  if [ "$count" = "0" ] && [ -n "${STUB_CODEX_FAIL_FIRST:-}" ]; then
    exit 1
  fi
fi

default_hallazgos() {
  printf '%s' '[{"severidad":"importante","ubicacion":"foo.py:2","problema":"division por cero","propuesta":"validar divisor"}]'
}
default_prose() {
  printf '%s' 'codex prosa de prueba: division por cero'
}

if [ -n "$out_file" ]; then
  if [ -z "${STUB_CODEX_EMPTY:-}" ]; then
    body="${STUB_CODEX_OUT:-$(default_hallazgos)}"
    printf '{"hallazgos":%s}' "$body" > "$out_file"
  fi
else
  printf '%s' "${STUB_CODEX_OUT:-$(default_prose)}"
fi

exit "${STUB_CODEX_RC:-0}"
